{
  "name": "maxquattromani",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "dev": "npm run build:preview && python3 -m http.server 4174 --bind 127.0.0.1 --directory dist",
    "launch:status": "node scripts/release.mjs",
    "release:check": "npm run build && node scripts/release.mjs --strict",
    "test:release": "node --test scripts/release-state.test.mjs scripts/editorial.test.mjs scripts/contact.test.mjs",
    "test:editorial": "node --test scripts/editorial.test.mjs",
    "build:preview": "node scripts/build.mjs --preview",
    "test:contact": "node --test scripts/contact.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "cheerio": "1.1.2",
    "js-yaml": "^4.3.2",
    "liquidjs": "^10.30.0",
    "markdown-it": "^14.3.3",
    "prettier": "3.9.10"
  }
}
